# Spotify API Credentials
# Get these from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/spotify/callback

# Muss 127.0.0.1 sein, nicht localhost (Spotify akzeptiert nur die literale
# Loopback-IP ohne HTTPS; localhost lehnt Spotify als "not secure" ab). Und muss
# mit dem Frontend-Origin uebereinstimmen, sonst blockt SameSite=Lax den Session-Cookie.
FRONTEND_URL=http://127.0.0.1:5173

# Anthropic API Key
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database
DATABASE_URL=postgresql://your_user:your_password@db:5432/your_db_name
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_db_name

# Session-Cookie-Signing (langer, zufälliger String, z.B. `openssl rand -hex 32`)
SESSION_SECRET_KEY=your_session_secret_key_here

# Verschlüsselt Spotify-Access/Refresh-Token in der DB (Fernet-Key, erzeugen mit
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`)
TOKEN_ENCRYPTION_KEY=your_fernet_key_here

# Nur bei lokalem HTTP-Dev auf false. In Prod (HTTPS via Caddy) auf true,
# sonst schickt der Browser den Cookie nicht mit.
COOKIE_SECURE=false